# Server-only configuration. Set the real values locally; never put credentials here.
# Use a disposable local API for tests. Staging/production origins are supplied by deployment.
DRIVECORE_API_ORIGIN=https://api.drivecore.innovize-tech.com
# Supports one or comma-separated allowed browser origins (e.g. www + apex in production):
# DRIVECORE_APP_ORIGIN=https://www.drivecore.innovize-tech.com,https://drivecore.innovize-tech.com
DRIVECORE_APP_ORIGIN=http://localhost:3000
# Must match Laravel SESSION_COOKIE (with APP_NAME=DriveCore, Laravel defaults to drivecore-session).
DRIVECORE_SESSION_COOKIE_NAME=drivecore-session
DRIVECORE_API_TIMEOUT_MS=15000
# Optional: demo only, requires API origin to be unset. Never enable for staging/production.
DRIVECORE_MODE=live
