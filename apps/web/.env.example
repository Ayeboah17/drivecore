# Server-only configuration. Set the real values locally; never put credentials here.
# Use a disposable local API for tests. Staging origin is supplied by deployment.
DRIVECORE_API_ORIGIN=https://drivecore.innovize-tech.com
DRIVECORE_APP_ORIGIN=http://localhost:3000
DRIVECORE_SESSION_COOKIE_NAME=drivecore_session
DRIVECORE_API_TIMEOUT_MS=15000
# Optional: demo only, requires API origin to be unset. Never enable for staging.
DRIVECORE_MODE=live
